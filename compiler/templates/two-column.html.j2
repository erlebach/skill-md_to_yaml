<h2 id="{{ slide_id }}-heading">{{ slide.title | e }}</h2>
{% if rendered_body %}<div class="slide-body">{{ rendered_body | safe }}</div>{% elif slide.body %}<div class="slide-body">{{ slide.body | e }}</div>{% endif %}
<div class="two-col two-col-{{ slide.proportion | replace('/', '-') }}">
  <div class="col-left">
    {% if slide.left %}
      {% if slide.left.type == 'figure' %}
        <img src="{{ slide.left.src | e }}" alt="{{ slide.left.alt_text | e }}">
      {% elif slide.left.type == 'diagram' %}
        <div role="img" aria-label="{{ slide.left.alt_text | e }}">{{ slide.left.source | safe }}</div>
      {% endif %}
    {% endif %}
  </div>
  <div class="col-right">
    {% if slide.right %}
      {% if slide.right.type == 'figure' %}
        <img src="{{ slide.right.src | e }}" alt="{{ slide.right.alt_text | e }}">
      {% elif slide.right.type == 'diagram' %}
        <div role="img" aria-label="{{ slide.right.alt_text | e }}">{{ slide.right.source | safe }}</div>
      {% endif %}
    {% endif %}
  </div>
</div>
{% if slide.notes %}<aside class="slide-notes" hidden aria-hidden="true">{{ slide.notes | e }}</aside>{% endif %}
