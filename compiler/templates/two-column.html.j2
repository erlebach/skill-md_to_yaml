<h2 id="{{ slide_id }}-heading">{{ slide.title | e }}</h2>
<div class="slide-content-area">
{% set body_html = rendered_body if rendered_body else (slide.body | e if slide.body else '') %}
{% set left_has_content = slide.left is not none %}
{% set right_has_content = slide.right is not none %}
{% set both_have_content = left_has_content and right_has_content %}
{% set body_in_column = body_html and (left_has_content != right_has_content) %}
{% if body_html and not body_in_column %}<div class="slide-body two-col-caption-above">{{ body_html | safe }}</div>{% endif %}
<div class="two-col two-col-{{ slide.proportion | replace('/', '-') }}{% if both_have_content %} two-col-both{% endif %}">
  <div class="col-left">
    {% if slide.left %}
      {% if slide.left.type == 'figure' %}
        <img src="{{ slide.left.src | e }}" alt="{{ slide.left.alt_text | e }}">
      {% elif slide.left.type == 'diagram' %}
        <div class="diagram-container" role="img" aria-label="{{ slide.left.alt_text | e }}">
          <pre class="mermaid" aria-hidden="true">{{ slide.left.source | e }}</pre>
        </div>
      {% endif %}
    {% elif body_in_column %}
      <div class="slide-body">{{ body_html | safe }}</div>
    {% endif %}
  </div>
  <div class="col-right">
    {% if slide.right %}
      {% if slide.right.type == 'figure' %}
        <img src="{{ slide.right.src | e }}" alt="{{ slide.right.alt_text | e }}">
      {% elif slide.right.type == 'diagram' %}
        <div class="diagram-container" role="img" aria-label="{{ slide.right.alt_text | e }}">
          <pre class="mermaid" aria-hidden="true">{{ slide.right.source | e }}</pre>
        </div>
      {% endif %}
    {% elif body_in_column %}
      <div class="slide-body">{{ body_html | safe }}</div>
    {% endif %}
  </div>
</div>
</div>
{% if slide.notes %}<aside class="slide-notes" hidden aria-hidden="true">{{ slide.notes | e }}</aside>{% endif %}
