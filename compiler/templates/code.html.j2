<h2 id="{{ slide_id }}-heading">{{ slide.title | e }}</h2>
<div style="position: relative;">
  <span class="code-language-label">{{ slide.language | e }}</span>
  {% if rendered_code %}
    {{ rendered_code | safe }}
  {% else %}
    <pre><code class="language-{{ slide.language | e }}">{% if slide.body %}{{ slide.body | e }}{% endif %}</code></pre>
  {% endif %}
</div>
{% if slide.notes %}<aside class="slide-notes" hidden aria-hidden="true">{{ slide.notes | e }}</aside>{% endif %}
