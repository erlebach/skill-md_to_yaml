<!DOCTYPE html>
<html lang="en" data-theme="{{ deck.metadata.theme }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ deck.metadata.title | e }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family={{ deck.metadata.font | replace(' ', '+') }}:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root[data-theme="dark"] {
      --bg: #0d1117;
      --bg2: #161b22;
      --text: #e6edf3;
      --muted: #8b949e;
      --accent: {% if deck.metadata.accent_color %}{{ deck.metadata.accent_color }}{% else %}#f0a500{% endif %};
      --border: #30363d;
      --font-family: '{{ deck.metadata.font }}', sans-serif;
    }

    :root[data-theme="light"] {
      --bg: #ffffff;
      --bg2: #f6f8fa;
      --text: #1f2328;
      --muted: #656d76;
      --accent: {% if deck.metadata.accent_color %}{{ deck.metadata.accent_color }}{% else %}#b06800{% endif %};
      --border: #d1d9e0;
      --font-family: '{{ deck.metadata.font }}', sans-serif;
    }

    html, body {
      height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-family);
    }

    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      z-index: 1000;
      background: var(--accent);
      color: var(--bg);
      padding: 0.5rem 1rem;
    }
    .skip-link:focus { left: 0; }

    #slide-counter {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      font-size: 0.875rem;
      color: var(--muted);
      z-index: 100;
    }

    main {
      scroll-snap-type: y mandatory;
      overflow-y: auto;
      height: 100vh;
    }

    section[role="group"] {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 3rem 5rem;
      scroll-snap-align: start;
    }

    h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; }
    h2 { font-size: 2rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--accent); }

    .slide-body { font-size: 1.25rem; line-height: 1.6; }
    .slide-body ul,
    .slide-body ol { padding-left: 1.5rem; }
    .slide-body li { margin-bottom: 0.5rem; }

    .two-col { display: grid; gap: 2rem; }
    .two-col-50-50 { grid-template-columns: 1fr 1fr; }
    .two-col-40-60 { grid-template-columns: 2fr 3fr; }
    .two-col-60-40 { grid-template-columns: 3fr 2fr; }

    blockquote {
      font-size: 1.75rem;
      font-style: italic;
      border-left: 4px solid var(--accent);
      padding-left: 1.5rem;
    }
    .attribution { color: var(--muted); margin-top: 1rem; }

    pre {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      padding: 1.5rem;
      overflow-x: auto;
      font-size: 1rem;
    }
    code { font-family: 'IBM Plex Mono', monospace; }

    .figure-container { text-align: center; }
    .figure-container img { max-width: 80%; max-height: 60vh; }

    .divider-slide { justify-content: center; align-items: center; text-align: center; }
    .divider-slide h2 { font-size: 3rem; color: var(--accent); }

    .steps-list {
      counter-reset: step;
      list-style: none;
      padding: 0;
    }
    .steps-list li {
      counter-increment: step;
      margin-bottom: 1rem;
      padding-left: 2.5rem;
      position: relative;
    }
    .steps-list li::before {
      content: counter(step);
      position: absolute;
      left: 0;
      color: var(--accent);
      font-weight: 700;
    }

    .summary-list { list-style: none; padding: 0; }
    .summary-list li::before { content: '\2713 '; color: var(--accent); font-weight: 700; }

    .slide-notes { display: none; }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <div id="slide-counter" aria-live="polite" aria-atomic="true">1 / {{ total }}</div>
  <main id="main-content" role="region" aria-roledescription="carousel" aria-label="{{ deck.metadata.title | e }}">
    {% for slide in deck.slides %}
    <section id="slide-{{ loop.index }}" role="group" aria-roledescription="slide" aria-label="Slide {{ loop.index }} of {{ total }}" aria-labelledby="slide-{{ loop.index }}-heading">
      {% include slide.layout ~ '.html.j2' %}
    </section>
    {% endfor %}
  </main>
  <script>
  (function() {
    var slides = Array.from(document.querySelectorAll('[role="group"]'));
    var idx = 0;
    function goTo(n) {
      idx = Math.max(0, Math.min(n, slides.length - 1));
      slides[idx].scrollIntoView({behavior: 'instant', block: 'start'});
      document.getElementById('slide-counter').textContent = (idx + 1) + ' / ' + slides.length;
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
        e.preventDefault(); goTo(idx + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault(); goTo(idx - 1);
      } else if (e.key === 'Home') {
        e.preventDefault(); goTo(0);
      } else if (e.key === 'End') {
        e.preventDefault(); goTo(slides.length - 1);
      }
    });
  })();
  </script>
</body>
</html>
