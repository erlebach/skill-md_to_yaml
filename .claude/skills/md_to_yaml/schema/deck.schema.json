            "dark",
            "light"
          ],
          "title": "Theme",
          "type": "string"
        },
        "accent_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accent Color"
        },
        "font": {
          "default": "IBM Plex Sans",
          "title": "Font",
          "type": "string"
        },
        "title_font_size": {
          "default": "2.4rem",
          "title": "Title Font Size",
          "type": "string"
        },
        "title_top_margin": {
          "default": "0.5rem",
          "title": "Title Top Margin",
          "type": "string"
        },
        "flavor": {
          "anyOf": [
            {
              "const": "transcript",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flavor"
        }
      },
      "required": [
        "title"
      ],
      "title": "DeckMetadata",
      "type": "object"
    },
