  "description": "Top-level deck container: metadata + ordered list of slides.",
  "properties": {
    "metadata": {
      "$ref": "#/$defs/DeckMetadata"
    },
    "slides": {
      "items": {
        "discriminator": {
          "mapping": {
            "code": "#/$defs/CodeSlide",
            "comparison": "#/$defs/ComparisonSlide",
            "content": "#/$defs/ContentSlide",
            "diagram": "#/$defs/DiagramSlide",
            "divider": "#/$defs/DividerSlide",
            "figure": "#/$defs/FigureSlide",
            "hero": "#/$defs/HeroSlide",
            "quote": "#/$defs/QuoteSlide",
            "steps": "#/$defs/StepsSlide",
            "summary": "#/$defs/SummarySlide",
            "table": "#/$defs/TableSlide",
            "title": "#/$defs/TitleSlide",
            "transcribe": "#/$defs/TranscribeSlide",
            "two-column": "#/$defs/TwoColumnSlide"
          },
          "propertyName": "layout"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TitleSlide"
          },
          {
            "$ref": "#/$defs/HeroSlide"
          },
          {
            "$ref": "#/$defs/ContentSlide"
          },
          {
            "$ref": "#/$defs/TranscribeSlide"
          },
          {
            "$ref": "#/$defs/DividerSlide"
          },
          {
            "$ref": "#/$defs/FigureSlide"
          },
          {
            "$ref": "#/$defs/DiagramSlide"
          },
          {
            "$ref": "#/$defs/TwoColumnSlide"
          },
          {
            "$ref": "#/$defs/QuoteSlide"
          },
          {
            "$ref": "#/$defs/ComparisonSlide"
          },
          {
            "$ref": "#/$defs/CodeSlide"
          },
          {
            "$ref": "#/$defs/StepsSlide"
          },
          {
            "$ref": "#/$defs/SummarySlide"
          },
          {
            "$ref": "#/$defs/TableSlide"
          }
        ]
      },
      "title": "Slides",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "slides"
  ],
  "title": "Deck",
  "type": "object"
