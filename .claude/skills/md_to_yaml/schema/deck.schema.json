    "DeckMetadata": {
      "additionalProperties": false,
      "description": "Deck-level metadata from the first frontmatter block.\n\nAttributes:\n    flavor: When set to ``\"transcript\"``, HTML output applies dense\n        left-aligned styling to ``content`` and ``table`` slides\n        (``/transcribe_to_html``). Omitted for standard presentation decks.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "date": {
