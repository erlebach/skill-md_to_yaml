  "$defs": {
    "CodeSlide": {
      "additionalProperties": false,
      "description": "Code block slide: title + fenced code in Markdown body. Language for syntax highlighting.",
      "properties": {
        "layout": {
          "const": "code",
          "title": "Layout",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "language": {
          "default": "text",
          "title": "Language",
          "type": "string"
        },
        "line_numbers": {
          "default": false,
          "title": "Line Numbers",
          "type": "boolean"
        }
      },
      "required": [
        "layout",
        "title"
      ],
      "title": "CodeSlide",
      "type": "object"
    },
